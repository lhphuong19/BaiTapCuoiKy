@model PagedResult<Product>
@{
    ViewBag.Title = "Danh mục sản phẩm";
    var filter = ViewBag.Filter as ProductFilterInputModel ?? new ProductFilterInputModel();
    var categories = ViewBag.Categories as List<SV22T1020337.Models.Catalog.Category> ?? new();
}

@section Styles {
    <style>
        /* ── Filter bar ── */
        .filter-bar {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.06);
            padding: 1.25rem 1.5rem;
            margin-bottom: 2rem;
        }

            .filter-bar .form-label {
                font-size: 0.72rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #9b9490;
                margin-bottom: 0.35rem;
            }

            .filter-bar .form-control,
            .filter-bar .form-select {
                border: 1.5px solid #e8e2da;
                border-radius: 8px;
                font-size: 0.875rem;
                background: #faf8f5;
                color: #1a1a1a;
                transition: border-color 0.2s, box-shadow 0.2s;
                padding: 0.45rem 0.75rem;
                height: auto;
            }

                .filter-bar .form-control:focus,
                .filter-bar .form-select:focus {
                    border-color: #c8590a;
                    box-shadow: 0 0 0 3px rgba(200,89,10,0.1);
                    background: #fff;
                }

        .btn-search {
            background: #1a1a1a;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.48rem 1.1rem;
            transition: background 0.2s, transform 0.15s;
            white-space: nowrap;
        }

            .btn-search:hover {
                background: #333;
                transform: translateY(-1px);
                color: #fff;
            }

        .btn-reset {
            border: 1.5px solid #e8e2da;
            background: transparent;
            color: #9b9490;
            border-radius: 8px;
            padding: 0.48rem 0.75rem;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

            .btn-reset:hover {
                border-color: #c8590a;
                color: #c8590a;
                background: rgba(200,89,10,0.04);
            }

        /* ── Section header ── */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1.25rem;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0;
        }

        .section-count {
            font-size: 0.8rem;
            color: #9b9490;
            font-weight: 500;
        }

        /* ── Product cards ── */
        .product-card {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            border: none;
            box-shadow: 0 2px 16px rgba(0,0,0,0.05);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 40px rgba(0,0,0,0.11);
            }

        .product-img-wrap {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4/3;
            background: #f5f2ed;
        }

            .product-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.4s ease;
            }

        .product-card:hover .product-img-wrap img {
            transform: scale(1.04);
        }

        .product-body {
            padding: 0.85rem 1rem 1rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .product-name {
            font-size: 0.85rem;
            font-weight: 500;
            color: #1a1a1a;
            line-height: 1.4;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-decoration: none;
        }

            .product-name:hover {
                color: #c8590a;
            }

        .product-price {
            font-size: 1rem;
            font-weight: 700;
            color: #c8590a;
            margin-bottom: 0.75rem;
            margin-top: auto;
        }

            .product-price small {
                font-size: 0.75rem;
                font-weight: 400;
                color: #9b9490;
            }

        .btn-add-cart {
            background: #1a1a1a;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.5rem;
            width: 100%;
            transition: background 0.2s, transform 0.15s;
        }

            .btn-add-cart:hover {
                background: #c8590a;
                transform: translateY(-1px);
            }

            .btn-add-cart:active {
                transform: scale(0.97);
            }

        /* ── Empty state ── */
        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
        }

            .empty-state .empty-icon {
                font-size: 3.5rem;
                margin-bottom: 1rem;
                opacity: 0.4;
            }

            .empty-state h5 {
                font-family: 'Playfair Display', serif;
                color: #6b6560;
                margin-bottom: 1rem;
            }

        /* ── Pagination ── */
        .pagination .page-link {
            border: 1.5px solid #e8e2da;
            color: #1a1a1a;
            border-radius: 8px !important;
            margin: 0 2px;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.4rem 0.75rem;
            transition: all 0.2s;
        }

            .pagination .page-link:hover {
                background: #1a1a1a;
                border-color: #1a1a1a;
                color: #fff;
            }

        .pagination .page-item.active .page-link {
            background: #c8590a;
            border-color: #c8590a;
            color: #fff;
        }

        .pagination .page-item.disabled .page-link {
            opacity: 0.35;
            pointer-events: none;
        }

        /* ── Toast ── */
        #cartToast {
            background: #1a1a1a !important;
            border-radius: 10px;
            font-size: 0.875rem;
            min-width: 240px;
        }
    </style>
}

<div class="container py-4">

    <!-- BỘ LỌC -->
    <div class="filter-bar">
        <form id="filterForm"
              method="get"
              action="~/Catalog/Search"
              data-target="searchResult"
              onsubmit="paginationSearch(event, this, 1)">
            <input type="hidden" name="PageSize" value="@filter.PageSize" />
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label">Tên sản phẩm</label>
                    <input type="text" class="form-control" name="SearchValue"
                           value="@filter.SearchValue" placeholder="Nhập tên sản phẩm..." autofocus />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label">Loại hàng</label>
                    <select class="form-select" name="CategoryID">
                        <option value="0">-- Tất cả loại hàng --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryID"
                                    selected="@(filter.CategoryID == cat.CategoryID ? "selected" : null)">
                                @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-md-2">
                    <label class="form-label">Giá từ (đ)</label>
                    <input type="number" class="form-control" name="MinPrice"
                           value="@(filter.MinPrice > 0 ? filter.MinPrice : "")" placeholder="Từ" min="0" />
                </div>
                <div class="col-6 col-sm-3 col-md-2">
                    <label class="form-label">Giá đến (đ)</label>
                    <input type="number" class="form-control" name="MaxPrice"
                           value="@(filter.MaxPrice > 0 ? filter.MaxPrice : "")" placeholder="Đến" min="0" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn-search flex-grow-1">Tìm kiếm</button>
                    <button type="button" class="btn-reset" title="Xóa bộ lọc" onclick="resetFilter()">✕</button>
                </div>
            </div>
        </form>
    </div>

    <!-- TIÊU ĐỀ -->
    <div class="section-header">
        <h5 class="section-title">Sản phẩm</h5>
    </div>

    <!-- KẾT QUẢ TÌM KIẾM (AJAX sẽ load _ProductList vào đây) -->
    <div id="searchResult"></div>

</div>

<!-- Toast thông báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="cartToast" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body text-white" id="toastMessage">Đã thêm vào giỏ hàng!</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tự động load kết quả khi trang vừa mở (trang hiện tại từ session)
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("filterForm"), @filter.Page);
        });

        function resetFilter() {
            const form = document.getElementById('filterForm');
            form.querySelector('[name="SearchValue"]').value = '';
            form.querySelector('[name="CategoryID"]').value = '0';
            form.querySelector('[name="MinPrice"]').value = '';
            form.querySelector('[name="MaxPrice"]').value = '';
            paginationSearch(null, form, 1);
        }

        // Dùng event delegation vì .btn-add-cart được load động qua AJAX
        document.getElementById('searchResult').addEventListener('click', async function (e) {
            const btn = e.target.closest('.btn-add-cart');
            if (!btn) return;

            const productId = btn.dataset.productId;
            const price = parseFloat(btn.dataset.productPrice);

            const resp = await fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productID: parseInt(productId), quantity: 1, salePrice: price })
            });
            const data = await resp.json();

            const badge = document.getElementById('cart-badge');
            if (badge && data.cartCount > 0) {
                badge.textContent = data.cartCount;
                badge.style.display = 'flex';
            }

            document.getElementById('toastMessage').textContent = data.message;
            new bootstrap.Toast(document.getElementById('cartToast')).show();
        });
    </script>
}
