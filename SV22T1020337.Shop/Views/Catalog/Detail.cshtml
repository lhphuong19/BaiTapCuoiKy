@model SV22T1020337.Models.Catalog.Product
@{
    ViewBag.Title = Model.ProductName;
    var photos = ViewBag.Photos as List<SV22T1020337.Models.Catalog.ProductPhoto> ?? new();
    var attributes = ViewBag.Attributes as List<SV22T1020337.Models.Catalog.ProductAttribute> ?? new();
    string mainPhoto = photos.FirstOrDefault()?.Photo ?? Model.Photo ?? "";
}

@section Styles {
    <style>
        /* ── Product Detail Page ─────────────────────────────── */
        .pd-wrap {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2.5rem 1rem 4rem;
        }

        /* Breadcrumb */
        .pd-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.82rem;
            color: #888;
            margin-bottom: 2rem;
        }

            .pd-breadcrumb a {
                color: #555;
                text-decoration: none;
            }

                .pd-breadcrumb a:hover {
                    color: #111;
                }

            .pd-breadcrumb .sep {
                color: #ccc;
            }

        /* Main grid */
        .pd-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: start;
        }
        @@media (max-width: 768px) {
            .pd-grid

        {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        }

        /* ── Gallery ──────────────────────────────────────────── */
        .pd-gallery {
        }

        .pd-main-img-wrap {
            background: #f8f8f6;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            position: relative;
        }

            .pd-main-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 24px;
                transition: transform 0.4s ease;
            }

            .pd-main-img-wrap:hover img {
                transform: scale(1.04);
            }

        .pd-thumbs {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .pd-thumb {
            width: 68px;
            height: 68px;
            border-radius: 10px;
            overflow: hidden;
            background: #f8f8f6;
            cursor: pointer;
            border: 2px solid transparent;
            transition: border-color 0.2s, transform 0.15s;
            flex-shrink: 0;
        }

            .pd-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .pd-thumb:hover {
                border-color: #111;
                transform: translateY(-2px);
            }

            .pd-thumb.active {
                border-color: #111;
            }

        /* ── Info Panel ───────────────────────────────────────── */
        .pd-info {
        }

        .pd-badge {
            display: inline-block;
            background: #e8f5e9;
            color: #2e7d32;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 6px;
            margin-bottom: 1rem;
        }

        .pd-title {
            font-size: 1.75rem;
            font-weight: 700;
            line-height: 1.25;
            color: #111;
            margin-bottom: 1.25rem;
            letter-spacing: -0.02em;
        }

        /* Price block */
        .pd-price-block {
            display: flex;
            align-items: baseline;
            gap: 10px;
            padding: 1.25rem 1.5rem;
            background: #111;
            color: #fff;
            border-radius: 14px;
            margin-bottom: 1.5rem;
        }

        .pd-price {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .pd-unit {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.55);
            font-weight: 400;
        }

        /* Description */
        .pd-desc {
            font-size: 0.93rem;
            color: #555;
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        /* Divider */
        .pd-divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 1.5rem 0;
        }

        /* Specs table */
        .pd-specs-heading {
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #999;
            margin-bottom: 0.85rem;
        }

        .pd-specs-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }

            .pd-specs-table tr {
                border-bottom: 1px solid #f0f0f0;
            }

                .pd-specs-table tr:last-child {
                    border-bottom: none;
                }

            .pd-specs-table td {
                padding: 9px 4px;
                vertical-align: top;
            }

                .pd-specs-table td:first-child {
                    color: #888;
                    width: 42%;
                    padding-right: 12px;
                }

                .pd-specs-table td:last-child {
                    color: #111;
                    font-weight: 500;
                }

        /* Quantity + CTA */
        .pd-qty-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .pd-qty-label {
            font-size: 0.82rem;
            color: #888;
            min-width: 52px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .pd-qty-control {
            display: flex;
            align-items: center;
            border: 1.5px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .pd-qty-btn {
            width: 40px;
            height: 40px;
            background: none;
            border: none;
            font-size: 1.2rem;
            color: #333;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
            user-select: none;
        }

            .pd-qty-btn:hover {
                background: #f5f5f5;
            }

        #quantity {
            width: 52px;
            height: 40px;
            border: none;
            border-left: 1.5px solid #ddd;
            border-right: 1.5px solid #ddd;
            text-align: center;
            font-size: 0.95rem;
            font-weight: 600;
            outline: none;
            -moz-appearance: textfield;
        }

            #quantity::-webkit-inner-spin-button,
            #quantity::-webkit-outer-spin-button {
                -webkit-appearance: none;
            }

        .pd-cta-row {
            display: flex;
            gap: 10px;
        }

        .pd-btn-cart {
            flex: 1;
            padding: 14px 20px;
            background: #111;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            letter-spacing: -0.01em;
        }

            .pd-btn-cart:hover {
                background: #333;
            }

            .pd-btn-cart:active {
                transform: scale(0.98);
            }

        .pd-btn-buy {
            padding: 14px 22px;
            background: #fff;
            color: #111;
            border: 1.5px solid #111;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

            .pd-btn-buy:hover {
                background: #f5f5f5;
                color: #111;
            }

            .pd-btn-buy:active {
                transform: scale(0.98);
            }

        /* Trust badges */
        .pd-trust {
            display: flex;
            gap: 16px;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .pd-trust-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: #777;
        }

        .pd-trust-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        /* ── Toast ────────────────────────────────────────────── */
        .pd-toast-wrap {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
        }

        .pd-toast {
            background: #111;
            color: #fff;
            border-radius: 12px;
            padding: 14px 20px;
            font-size: 0.88rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 220px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 0.25s, transform 0.25s;
            pointer-events: none;
        }

            .pd-toast.show {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }

        .pd-toast-dot {
            width: 8px;
            height: 8px;
            background: #4caf50;
            border-radius: 50%;
            flex-shrink: 0;
        }
    </style>
}

<div class="pd-wrap">
    <partial name="_BackToHome" />
    <!-- Breadcrumb -->
    <nav class="pd-breadcrumb" aria-label="breadcrumb">
        <a asp-controller="Catalog" asp-action="Index">Sản phẩm</a>
        <span class="sep">›</span>
        <span>@Model.ProductName</span>
    </nav>

    <div class="pd-grid">
        <!-- ── GALLERY ─────────────────────────────────── -->
        <div class="pd-gallery">
            <div class="pd-main-img-wrap">
                <img id="mainPhoto"
                     src="@(string.IsNullOrEmpty(mainPhoto) ? "/images/products/nophoto.png" : "/images/products/" + mainPhoto)"
                     alt="@Model.ProductName"
                     onerror="this.src='/images/products/nophoto.png'" />
            </div>

            @if (photos.Count > 1)
            {
                <div class="pd-thumbs">
                    @foreach (var p in photos)
                    {
                        <div class="pd-thumb @(p == photos.First() ? "active" : "")"
                             onclick="switchPhoto(this, '/images/products/@p.Photo')">
                            <img src="/images/products/@p.Photo"
                                 alt="@Model.ProductName"
                                 onerror="this.src='/images/products/nophoto.png'" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ── INFO ───────────────────────────────────── -->
        <div class="pd-info">
            <div class="pd-badge">✓ Còn hàng</div>

            <h1 class="pd-title">@Model.ProductName</h1>

            <!-- Price -->
            <div class="pd-price-block">
                <span class="pd-price">@Model.Price.ToString("N0") đ</span>
                <span class="pd-unit">/ @Model.Unit</span>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.ProductDescription))
            {
                <p class="pd-desc">@Model.ProductDescription</p>
            }

            <!-- Specs -->
            @if (attributes.Any())
            {
                <hr class="pd-divider" />
                <div class="pd-specs-heading">Thông số kỹ thuật</div>
                <table class="pd-specs-table">
                    <tbody>
                        @foreach (var attr in attributes)
                        {
                            <tr>
                                <td>@attr.AttributeName</td>
                                <td>@attr.AttributeValue</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <hr class="pd-divider" />

            <!-- Quantity -->
            <div class="pd-qty-row">
                <span class="pd-qty-label">Số lượng</span>
                <div class="pd-qty-control">
                    <button class="pd-qty-btn" id="btnMinus" type="button">−</button>
                    <input type="number" id="quantity" value="1" min="1" max="999" />
                    <button class="pd-qty-btn" id="btnPlus" type="button">+</button>
                </div>
            </div>

            <!-- CTA Buttons -->
            <div class="pd-cta-row">
                <button class="pd-btn-cart" id="btnAddToCart">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                    Thêm vào giỏ
                </button>
                <a asp-controller="Cart" asp-action="Index" class="pd-btn-buy">Mua ngay →</a>
            </div>

            <!-- Trust badges -->
            <div class="pd-trust">
                <div class="pd-trust-item">
                    <div class="pd-trust-icon">🚚</div>
                    <span>Giao hàng nhanh</span>
                </div>
                <div class="pd-trust-item">
                    <div class="pd-trust-icon">🔄</div>
                    <span>Đổi trả 30 ngày</span>
                </div>
                <div class="pd-trust-item">
                    <div class="pd-trust-icon">🔒</div>
                    <span>Thanh toán an toàn</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div class="pd-toast-wrap">
    <div class="pd-toast" id="pdToast">
        <div class="pd-toast-dot"></div>
        <span id="pdToastMsg">Đã thêm vào giỏ hàng!</span>
    </div>
</div>

@section Scripts {
    <script>
        const productId   = @Model.ProductID;
        const productName = @Json.Serialize(Model.ProductName);
        const price       = @Model.Price.ToString("G", System.Globalization.CultureInfo.InvariantCulture);
        const photo       = @Json.Serialize(Model.Photo ?? "");

        /* Gallery */
        function switchPhoto(thumb, src) {
            document.getElementById('mainPhoto').src = src;
            document.querySelectorAll('.pd-thumb').forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        }

        /* Quantity */
        document.getElementById('btnMinus').addEventListener('click', () => {
            const q = document.getElementById('quantity');
            if (parseInt(q.value) > 1) q.value = parseInt(q.value) - 1;
        });
        document.getElementById('btnPlus').addEventListener('click', () => {
            const q = document.getElementById('quantity');
            if (parseInt(q.value) < 999) q.value = parseInt(q.value) + 1;
        });

        /* Toast */
        let toastTimer;
        function showToast(msg, ok = true) {
            const toast = document.getElementById('pdToast');
            const dot   = toast.querySelector('.pd-toast-dot');
            document.getElementById('pdToastMsg').textContent = msg;
            dot.style.background = ok ? '#4caf50' : '#f44336';
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);
        }

        /* Add to cart */
        document.getElementById('btnAddToCart').addEventListener('click', async function () {
            const qty = parseInt(document.getElementById('quantity').value) || 1;
            try {
                const resp = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productID: productId, quantity: qty, salePrice: price })
                });
                const data = await resp.json();
                const badge = document.getElementById('cart-badge');
                if (badge && data.cartCount > 0) badge.textContent = data.cartCount;
                showToast(data.message ?? 'Đã thêm vào giỏ hàng!', resp.ok);
            } catch {
                showToast('Có lỗi xảy ra, vui lòng thử lại.', false);
            }
        });
    </script>
}
