@model PagedResult<Product>
@{
    Layout = null;
    var filter = ViewBag.Filter as SV22T1020337.Shop.Models.ProductFilterInputModel ?? new SV22T1020337.Shop.Models.ProductFilterInputModel();
}

<div class="mb-2 text-muted" style="font-size:0.85rem;">
    Tìm thấy <strong>@Model.RowCount</strong> sản phẩm
</div>

@if (!Model.DataItems.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h5>Không tìm thấy sản phẩm phù hợp.</h5>
    </div>
}
else
{
    <!-- Product grid -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
        @foreach (var product in Model.DataItems)
        {
            <div class="col">
                <div class="product-card">
                    <a asp-controller="Catalog" asp-action="Detail" asp-route-id="@product.ProductID"
                       style="text-decoration:none; display:block;">
                        <div class="product-img-wrap">
                            <img src="@(string.IsNullOrEmpty(product.Photo) ? "/images/products/nophoto.png" : "/images/products/" + product.Photo)"
                                 alt="@product.ProductName"
                                 onerror="this.src='/images/products/nophoto.png'" />
                        </div>
                    </a>
                    <div class="product-body">
                        <a class="product-name"
                           asp-controller="Catalog" asp-action="Detail" asp-route-id="@product.ProductID">
                            @product.ProductName
                        </a>
                        <div class="product-price">
                            @product.Price.ToString("N0") đ
                            <small>/@product.Unit</small>
                        </div>
                        <button class="btn-add-cart"
                                data-product-id="@product.ProductID"
                                data-product-name="@product.ProductName"
                                data-product-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-product-photo="@product.Photo"
                                data-product-unit="@product.Unit">
                            🛒 Thêm vào giỏ
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- PHÂN TRANG dùng GetDisplayPages() -->
    @if (Model.PageCount > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @foreach (var p in Model.GetDisplayPages())
                {
                    if (p.IsCurrent)
                    {
                        <li class="page-item active">
                            <a class="page-link">@p.Page</a>
                        </li>
                    }
                    else if (p.IsEllipsis)
                    {
                        <li class="page-item disabled">
                            <a class="page-link">...</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" href="javascript:;"
                               onclick="paginationSearch(event, document.getElementById('filterForm'), @p.Page)">
                                @p.Page
                            </a>
                        </li>
                    }
                }
            </ul>
        </nav>
    }
}
