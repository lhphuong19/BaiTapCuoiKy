@model SV22T1020337.Shop.Models.CustomerOrderSearchInput
@{
    ViewBag.Title = "Lịch sử đơn hàng";
}

<div class="container py-5">
    <partial name="_BackToHome" />
    <h3 class="fw-bold mb-4">📋 Lịch sử đơn hàng</h3>

    <!-- BỘ LỌC -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form id="searchForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Trạng thái</label>
                    <select class="form-select form-select-sm" name="Status" id="filterStatus">
                        <option value="0" selected="@(Model.Status == 0)">-- Tất cả --</option>
                        <option value="1"  selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.New)">🆕 Chờ xử lý</option>
                        <option value="2"  selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.Accepted)">✅ Đã duyệt</option>
                        <option value="3"  selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.Shipping)">🚚 Đang giao</option>
                        <option value="4"  selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.Completed)">🎉 Hoàn thành</option>
                        <option value="-1" selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.Cancelled)">❌ Đã hủy</option>
                        <option value="-2" selected="@(Model.Status == SV22T1020337.Models.Sales.OrderStatusEnum.Rejected)">⛔ Bị từ chối</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" name="DateFrom"
                           value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" name="DateTo"
                           value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                </div>
                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="PageSize" value="10" />
                <div class="col-md-3">
                    <button type="button" class="btn btn-dark btn-sm w-100" id="btnSearch">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    <!-- KẾT QUẢ -->
    <div id="orderListContainer">
        <div class="text-center py-4 text-muted">Đang tải...</div>
    </div>
</div>

@section Scripts {
<script>
async function loadOrders() {
    const form  = document.getElementById('searchForm');
    const data  = new URLSearchParams(new FormData(form));
    const resp  = await fetch('/Order/SearchHistory?' + data.toString());
    const html  = await resp.text();
    document.getElementById('orderListContainer').innerHTML = html;
}

document.getElementById('btnSearch').addEventListener('click', loadOrders);
loadOrders();

// Phân trang — delegated
document.getElementById('orderListContainer').addEventListener('click', function (e) {
    const pager = e.target.closest('[data-page]');
    if (pager) {
        document.querySelector('[name="Page"]').value    = pager.dataset.page;
        document.querySelector('[name="PageSize"]').value = pager.dataset.pagesize || 10;
        loadOrders();
    }
    // Hủy đơn hàng
    const cancelBtn = e.target.closest('.btn-cancel-order');
    if (cancelBtn) {
        const orderId = cancelBtn.dataset.id;
        if (confirm('Bạn có chắc muốn hủy đơn hàng #' + orderId + '?')) {
            fetch('/Order/Cancel/' + orderId, { method: 'POST' })
                .then(r => r.json())
                .then(d => {
                    alert(d.message);
                    if (d.success) loadOrders();
                });
        }
    }
});
</script>
}
