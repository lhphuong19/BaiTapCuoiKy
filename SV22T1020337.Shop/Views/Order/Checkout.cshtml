@model SV22T1020337.Shop.Models.CheckoutModel
@{
    ViewBag.Title = "Đặt hàng";
    var cart = ViewBag.Cart as List<SV22T1020337.Models.Sales.OrderDetailViewInfo> ?? new();
    decimal total = ViewBag.Total is decimal t ? t : 0m;
}

<div class="container py-5">
    <h3 class="fw-bold mb-4">📦 Xác nhận đặt hàng</h3>

    <div class="row g-4">
        <!-- FORM GIAO HÀNG -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">Thông tin giao hàng</div>
                <div class="card-body">
                    <form asp-controller="Order" asp-action="Checkout" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

                        <div class="mb-3">
                            <label asp-for="DeliveryProvince" class="form-label fw-semibold"></label>
                            <input asp-for="DeliveryProvince" class="form-control"
                                   placeholder="Ví dụ: Hà Nội, TP. Hồ Chí Minh..." />
                            <span asp-validation-for="DeliveryProvince" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DeliveryAddress" class="form-label fw-semibold"></label>
                            <textarea asp-for="DeliveryAddress" class="form-control" rows="3"
                                      placeholder="Số nhà, tên đường, phường/xã..."></textarea>
                            <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                                ← Quay lại giỏ hàng
                            </a>
                            <button type="submit" class="btn btn-warning fw-bold px-5">
                                Xác nhận đặt hàng 🎉
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- TÓM TẮT GIỎ HÀNG -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">
                    Đơn hàng của bạn (@cart.Count sản phẩm)
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in cart)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(item.Photo) ? "/images/products/nophoto.png" : "/images/products/" + item.Photo)"
                                     style="width:48px;height:48px;object-fit:cover;border-radius:6px;"
                                     onerror="this.src='/images/products/nophoto.png'" alt="@item.ProductName" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <small class="text-muted">x@item.Quantity &nbsp;@item.Unit</small>
                                </div>
                                <div class="fw-bold text-danger small">
                                    @((item.Quantity * item.SalePrice).ToString("N0")) đ
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="p-3 border-top">
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Tổng cộng:</span>
                            <span class="text-danger">@total.ToString("N0") đ</span>
                        </div>
                        <small class="text-muted">Phí vận chuyển sẽ được tính khi giao hàng.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
