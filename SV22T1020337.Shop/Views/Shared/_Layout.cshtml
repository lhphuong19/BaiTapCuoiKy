<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | " : "")Rau Ma Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/shop.css" />
    <style>
        :root {
            --cream: #faf8f5;
            --warm-white: #ffffff;
            --charcoal: #1a1a1a;
            --accent: #c8590a;
            --accent-light: #f0ebe4;
            --muted: #6b6560;
            --border: #e8e2da;
            --card-shadow: 0 2px 20px rgba(0,0,0,0.06);
            --card-shadow-hover: 0 8px 40px rgba(0,0,0,0.12);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: var(--cream);
            color: var(--charcoal);
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Playfair Display', serif;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    @await Html.PartialAsync("_Header")

    <!-- FLASH MESSAGES -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 text-center" role="alert"
             style="background:#d4edda; border:none; border-bottom: 1px solid #c3e6cb; font-family:'DM Sans',sans-serif; font-size:.9rem;">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 text-center" role="alert"
             style="background:#f8d7da; border:none; border-bottom:1px solid #f5c6cb; font-family:'DM Sans',sans-serif; font-size:.9rem;">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MAIN CONTENT -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/shop.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
