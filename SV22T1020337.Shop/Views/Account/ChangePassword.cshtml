@model ChangePasswordModel
@{
    ViewBag.Title = "Đổi mật khẩu";
}

<style>
    .input-validation-error {
        border: 1px solid #dc3545;
        background-color: #fff0f0;
    }
</style>

<div class="container py-5">
    <partial name="_BackToHome" />
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <!-- Tabs -->
            <ul class="nav nav-pills mb-4 gap-2">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Profile">
                        👤 Thông tin cá nhân
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active bg-dark" asp-controller="Account" asp-action="ChangePassword">
                        🔒 Đổi mật khẩu
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Order" asp-action="History">
                        📋 Đơn hàng
                    </a>
                </li>
            </ul>

            <div class="card border-0 shadow">
                <div class="card-header bg-dark text-white fw-bold">
                    🔒 Đổi mật khẩu
                </div>

                <div class="card-body p-4">

                    <!-- SUCCESS -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success py-2 small">
                            @ViewBag.Success
                        </div>
                    }

                    <!-- ERROR SUMMARY -->
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger py-2 small"></div>
                    }

                    <form asp-action="ChangePassword" method="post" novalidate>

                        <!-- OLD PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="OldPassword" class="form-control"
                                       id="oldPwd"
                                       placeholder="Nhập mật khẩu cũ"
                                       autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="toggleVis('oldPwd', this)">
                                    👁
                                </button>
                            </div>
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <!-- NEW PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="NewPassword" class="form-control"
                                       id="newPwd"
                                       placeholder="Nhập mật khẩu mới"
                                       autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="toggleVis('newPwd', this)">
                                    👁
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <!-- CONFIRM -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control"
                                       id="confirmPwd"
                                       placeholder="Nhập lại mật khẩu"
                                       autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="toggleVis('confirmPwd', this)">
                                    👁
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- INFO -->
                        <div class="alert alert-info py-2 small">
                            💡 Mật khẩu nên có ít nhất 6 ký tự, bao gồm chữ và số.
                        </div>

                        <!-- SUBMIT -->
                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-dark fw-bold py-2"
                                    onclick="this.disabled=true; this.form.submit();">
                                Đổi mật khẩu
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Show / hide password
        function toggleVis(id, btn) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.textContent = input.type === 'password' ? '👁' : '🙈';
        }

        // Focus vào input lỗi đầu tiên
        document.addEventListener("DOMContentLoaded", function () {
            const firstError = document.querySelector(".input-validation-error");
            if (firstError) firstError.focus();
        });

        // Xóa highlight khi user nhập lại
        document.querySelectorAll("input").forEach(input => {
            input.addEventListener("input", () => {
                input.classList.remove("input-validation-error");
            });
        });

        // Auto ẩn thông báo success
        setTimeout(() => {
            const alert = document.querySelector(".alert-success");
            if (alert) alert.style.display = "none";
        }, 3000);
    </script>
}