@model List<SV22T1020337.Models.Sales.OrderDetailViewInfo>
@{
    ViewBag.Title = "Giỏ hàng";
    decimal total = Model.Sum(c => c.Quantity * c.SalePrice);
}

<div class="container py-5">
    <h3 class="fw-bold mb-4">🛒 Giỏ hàng của tôi</h3>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="fs-1 mb-3">🛒</div>
            <h5 class="text-muted">Giỏ hàng của bạn đang trống</h5>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-dark mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Danh sách sản phẩm -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:50%">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center" style="width:130px">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="cartBody">
                                @foreach (var item in Model)
                                {
                                    <tr id="row-@item.ProductID">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(item.Photo) ? "/images/products/nophoto.png" : "/images/products/" + item.Photo)"
                                                     alt="@item.ProductName" style="width:56px;height:56px;object-fit:cover;border-radius:6px;"
                                                     onerror="this.src='/images/products/nophoto.png'" />
                                                <div>
                                                    <div class="fw-semibold">@item.ProductName</div>
                                                    <small class="text-muted">@item.Unit</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="unit-price-@item.ProductID">@item.SalePrice.ToString("N0")</span> đ
                                        </td>
                                        <td class="text-center">
                                            <div class="input-group input-group-sm justify-content-center" style="width:110px;margin:auto">
                                                <button class="btn btn-outline-secondary btn-minus"
                                                        data-id="@item.ProductID" data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                    −
                                                </button>
                                                <input type="number" class="form-control text-center qty-input"
                                                       id="qty-@item.ProductID" value="@item.Quantity" min="1"
                                                       data-id="@item.ProductID" data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                <button class="btn btn-outline-secondary btn-plus"
                                                        data-id="@item.ProductID" data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                    +
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            <span id="subtotal-@item.ProductID">@((item.Quantity * item.SalePrice).ToString("N0"))</span> đ
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-danger btn-remove"
                                                    data-id="@item.ProductID" title="Xóa">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-3">
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">
                        ← Tiếp tục mua sắm
                    </a>
                    <button class="btn btn-outline-danger" id="btnClearCart">Xóa tất cả</button>
                </div>
            </div>

            <!-- Tóm tắt đơn hàng -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold">Tóm tắt đơn hàng</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Số mặt hàng:</span>
                            <span id="totalCount" class="fw-semibold">@Model.Count</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tạm tính:</span>
                            <span id="totalAmount" class="fw-bold text-danger fs-5">@total.ToString("N0") đ</span>
                        </div>
                        <hr />
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Order" asp-action="Checkout"
                               class="btn btn-warning w-100 fw-bold">Đặt hàng ngay →</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="btn btn-dark w-100 fw-bold">Đăng nhập để đặt hàng</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function formatVND(n) {
            return n.toLocaleString('vi-VN') + ' đ';
        }

        async function updateCart(productId, qty, price) {
            const params = new URLSearchParams({ productId, quantity: qty, salePrice: price });
            const resp = await fetch('/Cart/UpdateCart?' + params.toString(), {
                method: 'POST'
            });
            const data = await resp.json();
            if (data.success) {
                document.getElementById('subtotal-' + productId).textContent = formatVND(qty * price).replace(' đ','');
                document.getElementById('totalAmount').textContent = formatVND(data.total);
                document.getElementById('totalCount').textContent  = data.count;
                const badge = document.getElementById('cart-badge');
                if (badge) badge.textContent = data.count > 0 ? data.count : '';
            }
        }

        // Nút + / -
        document.querySelectorAll('.btn-minus').forEach(btn => {
            btn.addEventListener('click', function () {
                const id    = this.dataset.id;
                const price = parseFloat(this.dataset.price);
                const input = document.getElementById('qty-' + id);
                if (parseInt(input.value) > 1) {
                    input.value = parseInt(input.value) - 1;
                    updateCart(id, parseInt(input.value), price);
                }
            });
        });
        document.querySelectorAll('.btn-plus').forEach(btn => {
            btn.addEventListener('click', function () {
                const id    = this.dataset.id;
                const price = parseFloat(this.dataset.price);
                const input = document.getElementById('qty-' + id);
                input.value = parseInt(input.value) + 1;
                updateCart(id, parseInt(input.value), price);
            });
        });

        // Thay đổi số lượng trực tiếp
        document.querySelectorAll('.qty-input').forEach(input => {
            input.addEventListener('change', function () {
                const id    = this.dataset.id;
                const price = parseFloat(this.dataset.price);
                let qty     = parseInt(this.value);
                if (isNaN(qty) || qty < 1) { qty = 1; this.value = 1; }
                updateCart(id, qty, price);
            });
        });

        // Xóa 1 sản phẩm
        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id = this.dataset.id;
                const params = new URLSearchParams({ productId: id });
                const resp = await fetch('/Cart/RemoveFromCart?' + params.toString(), {
                    method: 'POST'
                });
                const data = await resp.json();
                if (data.success) {
                    document.getElementById('row-' + id)?.remove();
                    document.getElementById('totalAmount').textContent = formatVND(data.total);
                    document.getElementById('totalCount').textContent  = data.cartCount;
                    const badge = document.getElementById('cart-badge');
                    if (badge) badge.textContent = data.cartCount > 0 ? data.cartCount : '';
                    if (data.cartCount === 0) location.reload();
                }
            });
        });

        // Xóa tất cả
        document.getElementById('btnClearCart')?.addEventListener('click', async () => {
            if (!confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')) return;
            await fetch('/Cart/ClearCart', { method: 'POST' });
            location.reload();
        });
    </script>
}
