@model OrderViewInfo
@{
    Layout = null;
    var shippers = ViewBag.Shippers as SV22T1020337.Models.Common.PagedResult<SV22T1020337.Models.Partner.Shipper>;
}

<form id="shippingForm" method="post" action="@Url.Action("Shipping", "Order", new { id = Model.OrderID })">

    <div class="modal-header text-bg-info">
        <strong class="modal-title">
            <i class="bi bi-truck me-1"></i>
            Chuyển giao hàng
        </strong>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

        <!-- HIỂN THỊ LỖI -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="alert alert-info">
            Chọn người giao hàng cho đơn hàng <strong>#@Model.OrderID</strong>.
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">
                Người giao hàng <span class="text-danger">*</span>
            </label>

            <select name="shipperID" class="form-select">
                <option value="0">-- Chọn người giao hàng --</option>
                @if (shippers != null)
                {
                    foreach (var s in shippers.DataItems)
                    {
                        <option value="@s.ShipperID">@s.ShipperName - @s.Phone</option>
                    }
                }
            </select>
        </div>

        <div class="text-muted small">
            <div><b>Khách hàng:</b> @(string.IsNullOrEmpty(Model.CustomerName) ? "Khách lẻ" : Model.CustomerName)</div>
            <div><b>Địa chỉ:</b> @Model.DeliveryAddress</div>
            <div><b>Tỉnh/thành:</b> @Model.DeliveryProvince</div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-info text-white">
            <i class="bi bi-truck me-1"></i> Xác nhận giao hàng
        </button>

        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Đóng
        </button>
    </div>

</form>

<!-- AJAX SUBMIT -->
<script>
    $(document).off("submit", "#shippingForm").on("submit", "#shippingForm", function (e) {
        e.preventDefault();

        var form = $(this);

        $.ajax({
            url: form.attr("action"),
            type: "POST",
            data: form.serialize(),
            success: function (res) {
                // load lại nội dung modal
                $("#dialogModal .modal-content").html(res);
            },
            error: function () {
                alert("Có lỗi xảy ra!");
            }
        });
    });
</script>