@{
    ViewBag.Title = "Thay đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-12">

        <form method="post" action="@Url.Action("ChangePassword", "Account")">

            <div class="card card-warning card-outline">
                <div class="card-body">

                    <!-- THÔNG BÁO THÀNH CÔNG -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.Success
                        </div>
                    }

                    <!-- MẬT KHẨU CŨ -->
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu cũ</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input type="password"
                                   name="oldPassword"
                                   class="form-control @(ViewData.ModelState["oldPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   placeholder="Nhập mật khẩu cũ">
                        </div>
                        <span class="text-danger">
                            @Html.ValidationMessage("oldPassword")
                        </span>
                    </div>

                    <!-- MẬT KHẨU MỚI -->
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield-lock-fill"></i>
                            </span>
                            <input type="password"
                                   name="newPassword"
                                   class="form-control @(ViewData.ModelState["newPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   placeholder="Nhập mật khẩu mới">
                        </div>
                        <span class="text-danger">
                            @Html.ValidationMessage("newPassword")
                        </span>
                    </div>

                    <!-- XÁC NHẬN MẬT KHẨU -->
                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                            <input type="password"
                                   name="confirmPassword"
                                   class="form-control @(ViewData.ModelState["confirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   placeholder="Nhập lại mật khẩu">
                        </div>
                        <span class="text-danger">
                            @Html.ValidationMessage("confirmPassword")
                        </span>
                    </div>

                </div>

                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Đổi mật khẩu
                    </button>

                    <a href="~/" class="btn btn-secondary me-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>

        </form>

    </div>
</div>